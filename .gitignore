# ============================================================
# 根目录 .gitignore —— 适用于 backend(Spring Boot) + web(Vue)
# 子模块中已有的 .gitignore 继续生效，本文件统一兜底
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
nbproject/private/
nbbuild/
nbdist/
.claude/settings.local.json

# ---------- Java / Maven ----------
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
coverage/
.npm/
.yarn/
.pnpm-store/

# 包管理 / 构建日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 环境变量 / 本地配置 ----------
.env
.env.*
!.env.example
!*.env.example
**/src/main/resources/application-local.*
**/src/test/resources/application-local.*

# ---------- 日志 / 临时文件 ----------
logs/
*.tmp
*.bak
*.swp
*~

# ---------- 上传 / 生成目录（按需启用） ----------
# uploads/
# upload/
# /data/
